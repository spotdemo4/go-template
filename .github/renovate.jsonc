{
  "$schema": "https://docs.renovatebot.com/renovate-global-schema.json",

  // self-hosted
  "onboarding": false,
  "requireConfig": "ignored",
  "platform": "github",
  "repositories": ["spotdemo4/go-template"],
  "allowedCommands": ["^nix run \\.#update-deps$"],

  // repository
  "extends": ["config:recommended"],
  "addLabels": ["dep"],
  "prHourlyLimit": 0,
  "nix": {
    "enabled": true
  },
  // fix PRs for vulnerable direct and indirect go modules, from osv.dev
  "osvVulnerabilityAlerts": true,
  "dependencyDashboard": { "osvVulnerabilitySummary": "unresolved" },
  "vulnerabilityAlerts": {
    "addLabels": ["security"],
    "automerge": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* * * * 0"], // sunday
    "skipInstalls": false
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchManagers": ["nix"],
      "addLabels": ["nix"]
    },
    {
      "matchManagers": ["nix"],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["actions"]
    },
    {
      // includes go.mod's toolchain line, which tracks upstream go releases. Its
      // PRs fail the go-toolchain check until the locked trevpkgs' go-latest has
      // the release, then lock file maintenance brings it in and they're rebased
      "matchManagers": ["gomod"],
      "addLabels": ["go"],
      "postUpdateOptions": ["gomodUpdateImportPaths"],
      // gomod2nix.toml has an entry per module, so updates do not conflict
      "postUpgradeTasks": {
        "commands": ["nix run .#update-deps"],
        "executionMode": "branch"
      }
    }
  ]
}
